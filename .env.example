# Base de datos Neon (pooler para la app)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require"

# Base de datos Neon (directo para migraciones)
DIRECT_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# NextAuth
AUTH_SECRET="clave-secreta-aleatoria"
NEXTAUTH_URL="https://tu-dominio.vercel.app"

# Gmail SMTP (recuperación de contraseña)
GMAIL_USER="tu@gmail.com"
GMAIL_APP_PASSWORD="contraseña-de-aplicacion-gmail"

# Resend (emails de notificaciones y cotizaciones) — solo en Vercel env vars
RESEND_API_KEY="re_..."

# Correo entrante (respuestas de clientes) — buzón Gmail gratuito de ingest.
# Si no se configuran, el envío sigue funcionando y el Reply-To cae al correo
# del vendedor (comportamiento anterior); no se capturan respuestas.
# INGEST_EMAIL_BASE: la dirección del buzón, ej. crmevoluteca@gmail.com
# INGEST_IMAP_PASSWORD: contraseña de aplicación de Gmail (requiere 2FA + IMAP activo)
INGEST_EMAIL_BASE="crmevoluteca@gmail.com"
INGEST_IMAP_PASSWORD="contraseña-de-aplicacion-gmail"
# Opcionales (por defecto Gmail): INGEST_IMAP_HOST / INGEST_IMAP_PORT
# INGEST_IMAP_HOST="imap.gmail.com"
# INGEST_IMAP_PORT="993"
# El chequeo de entrada lo dispara un GitHub Action cada 15 min (Vercel Hobby no
# admite crons frecuentes): ver .github/workflows/correos-entrantes.yml

# Cron jobs — solo en Vercel env vars. CRON_SECRET protege los endpoints /api/cron/*
# y también lo usa el GitHub Action de correos entrantes (guárdalo igual en GitHub).
CRON_SECRET="clave-secreta-cron"

# Admin — clave para crear nuevos tenants
ADMIN_REGISTRO_SECRET="clave-secreta-admin"
